{
  "name": "@astralarium/react-stage",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "description": "Performant reparenting in React",
  "license": "MIT",
  "author": "Mara Kim <mara@astralarium.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astralarium/react-stage.git"
  },
  "keywords": [
    "react",
    "reparenting",
    "portal",
    "react-three-fiber",
    "three"
  ],
  "bugs": {
    "url": "https://github.com/astralarium/react-stage/issues"
  },
  "homepage": "https://astralarium.github.io/react-stage",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "concurrently -P \"typedoc --watch --preserveWatchOutput\" \"vite --config vite.pages.config.ts {@}\" --",
    "build": "tsc -b && eslint . && vite build",
    "build:pack": "pnpm pack --out pack/%s-%v.tgz",
    "prepack": "pnpm build",
    "build:pages": "typedoc && vite build --config vite.pages.config.ts",
    "preview": "vite preview --config vite.pages-preview.config.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "check-types": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./its-fine": {
      "types": "./dist/its-fine/index.d.ts",
      "default": "./dist/its-fine/index.js"
    },
    "./r3f": {
      "types": "./dist/r3f/index.d.ts",
      "default": "./dist/r3f/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=10.0.0-alpha.6 <11",
    "its-fine": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": ">=0.186.0"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "its-fine": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@base-ui/react": "^1.9.0",
    "@eslint/js": "^10.0.1",
    "@react-three/fiber": "10.0.0-alpha.6",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "its-fine": "^2.1.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.76.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "three": "0.186.1",
    "tw-animate-css": "^1.4.0",
    "typedoc": "^0.28.20",
    "typedoc-rhineai-theme": "^1.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.1"
  }
}
